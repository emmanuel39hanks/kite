{
  "name": "kite",
  "private": true,
  "description": "Kite: a self-custodied portfolio on NEAR that rebalances itself through NEAR Intents.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test:contracts": "cargo test --manifest-path contracts/Cargo.toml -p kite-vault -p kite-factory --lib",
    "verify": "node scripts/verify.mjs",
    "test:integration": "sh scripts/integration.sh",
    "attack": "npm run attack -w packages/keeper --",
    "keeper": "npm run keeper -w packages/keeper --"
  },
  "engines": {
    "node": ">=22.9"
  },
  "overrides": {
    "@freedomofpress/crypto-browser": {
      "@noble/curves": "1.9.7"
    }
  }
}
