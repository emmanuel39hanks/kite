{
  "name": "film",
  "version": "0.1.0",
  "private": true,
  "description": "Kite's intro film, rendered with Remotion from Kite's real UI components.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Intro out/kite-intro.mp4 --codec h264 --crf 16",
    "still": "remotion still src/index.ts Intro",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.542",
    "@remotion/google-fonts": "4.0.542",
    "@remotion/tailwind-v4": "4.0.542",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.542",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "^5"
  }
}
