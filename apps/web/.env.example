# Public half of Kite's keeper key; every vault adds it as a rebalance/settle-only key.
NEXT_PUBLIC_KITE_AGENT_PK=ed25519:...
# Server only. Without it everything runs dry (real quotes, nothing sent). Even with it, real
# the daily run acts on vaults in KITE_VAULTS and on every vault Kite's factory made that carries this key.
# KITE_AGENT_KEY=ed25519:...
# Required for /api/cron (it refuses every call without it). KITE_VAULTS: vaults the daily run checks first.
CRON_SECRET=
# KITE_VAULTS=<name>.kitevaults.near
# Optional 1Click partner JWT (lower fees).
ONECLICK_JWT=
# Server only. Powers the private AI features through a relay; leave out and they show "not configured".
NEARAI_API_KEY=

# Optional overrides (defaults shown).
# NEXT_PUBLIC_NEAR_RPC=https://rpc.mainnet.fastnear.com   # browser RPC
# NEAR_RPC=https://rpc.mainnet.fastnear.com               # keeper / server RPC
# INTENTS_CONTRACT=intents.near
# ONECLICK_URL=https://1click.chaindefuser.com/v0
# Keeper CLI only (npm run keeper / attack): KITE_VAULT=<name>.kitevaults.near   ATTACKER=<account for the attack demo>
