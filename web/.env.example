# Public half of Kite's worker key; every vault adds it as a rebalance/settle-only key.
NEXT_PUBLIC_KITE_AGENT_PK=ed25519:...
# Server only. Without it everything runs dry (real quotes, nothing sent). Even with it, real
# transactions go only to vaults listed in KITE_VAULTS.
KITE_AGENT_KEY=ed25519:...
# Required for /api/cron (it refuses every call without it). KITE_VAULTS: vaults the server may act on.
CRON_SECRET=
KITE_VAULTS=kite.you.near
# Optional 1Click partner JWT (lower fees).
ONECLICK_JWT=
# Server only. Powers the private AI features through a relay; leave out and they show "not configured".
NEARAI_API_KEY=

# Optional overrides (defaults shown).
# NEXT_PUBLIC_NEAR_RPC=https://rpc.mainnet.fastnear.com   # browser RPC
# NEAR_RPC=https://rpc.mainnet.fastnear.com               # worker / server RPC
# INTENTS_CONTRACT=intents.near
# ONECLICK_URL=https://1click.chaindefuser.com/v0
# Worker CLI only (npm run worker / attack): KITE_VAULT=kite.you.near   ATTACKER=<account for the attack demo>
